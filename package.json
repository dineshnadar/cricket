{
  "name": "wisdom-ops",
  "version": "1.0.0",
  "private": true,
  "description": "Agents that watch the repos behind a module, triage every change with Claude, trigger test pipelines, notify the team, and correlate prod incidents with recent changes.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "worker": "tsx src/worker/index.ts",
    "worker:once": "tsx src/worker/index.ts --once",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mock": "node mock/server.js",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/fira-sans": "^5.3.0",
    "lucide-react": "^1.56.0",
    "mongodb": "^6.21.0",
    "next": "^15.5.27",
    "nodemailer": "^6.10.1",
    "picomatch": "^4.0.3",
    "react": "^19.1.9",
    "react-dom": "^19.1.9",
    "react-markdown": "^10.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/picomatch": "^4.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
