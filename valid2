    Start([START: FA Receives Client Request]) --> QueryClient[Query Existing Clients<br/>Check for: Sanjay<br/>Found: Upendra, Rajat]
    
    QueryClient --> ConfirmTrust[Confirm Trust Details<br/>- Sanjay Trust<br/>- Sanjay R TTTST<br/>- SANTY STST<br/>- Grantor Retained Trust<br/>- 3 Users]
    
    ConfirmTrust --> CheckDocs{Verify Account<br/>Documents}
    
    CheckDocs --> AvailDocs[✓ Available Documents:<br/>- Sanjay R: Ws/JPP A1 OnDemand IND, IRA<br/>- Sanjay S: Ws/JPP A2 OnDemand IRS, IND<br/>- Sanjay R: Trust Certification 330]
    
    CheckDocs --> MissingDocs[✗ Missing Documents:<br/>- Trust Agreement<br/>- AAA Agreement]
    
    AvailDocs --> CollectDocs{How to collect<br/>missing docs?}
    MissingDocs --> CollectDocs
    
    CollectDocs -->|Option A| SendEmail[Send Email Request]
    CollectDocs -->|Option B| SendESign[Send eSign Document]
    
    SendEmail --> eSignProcess
    SendESign --> eSignProcess[eSign Document Process<br/>via DocuCentral Agent]
    
    eSignProcess --> ClientView[Client Views<br/>eSign Document]
    
    ClientView --> ClientSign[Client Signs Digitally<br/>Contact: sanja***@hot]
    
    ClientSign --> CheckProgress[Check Progress &<br/>Reconnect to Sanjay]
    
    CheckProgress --> ReceiveDoc[Receive Document from<br/>DocuCentral Agent]
    
    ReceiveDoc --> DocApproved{Document<br/>Approved?}
    
    DocApproved -->|Yes| OpenAccount[Open the Account<br/>- Summary Accept Consent<br/>- Account ready for submission<br/>- Note: Client interested in Joint Account]
    
    DocApproved -->|No| eSignProcess
    
    OpenAccount --> SubmitDocs[Submit Account Documents<br/>- Trust Account<br/>- Joint Account combined<br/>- Client can sign LSP document]
    
    SubmitDocs --> JointAccount{Process Joint<br/>Account?}
    
    JointAccount -->|Yes| JointProcess[Process Joint Account<br/>- Available Doc: Joint Acct Doc<br/>- Missing: AAA Agreement<br/>- Continue submission]
    
    JointAccount -->|No| FinalReview
    
    JointProcess --> FinalReview[Final Document Review<br/>- Send eSign Doc<br/>- Check Progress<br/>- Document Received]
    
    FinalReview --> AccountSetup[Account Setup Through<br/>Approved Process]
    
    AccountSetup --> End([COMPLETE: Account<br/>Successfully Opened])
    
